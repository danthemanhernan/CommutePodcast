{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CheckBucketObjects",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR-BUCKET"
    },
    {
      "Sid": "PublishPodcastFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": [
        "arn:aws:s3:::YOUR-BUCKET/YOUR-RANDOM-PREFIX/feed.xml",
        "arn:aws:s3:::YOUR-BUCKET/YOUR-RANDOM-PREFIX/media/*"
      ]
    }
  ]
}
